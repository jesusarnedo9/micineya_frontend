{
  "expo": {
    "name": "MiCineYa",
    "slug": "micineya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/micineya-icon-v1.png",
    "scheme": "micineapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.micineya.app",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#080607",
        "foregroundImage": "./assets/images/micineya-icon-foreground-v1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080607",
          "image": "./assets/images/micineya-icon-foreground-v1.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Elegí una foto para tu perfil de MiCineYa.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf40c5a2-3415-4074-b76a-ec43657b0c6e"
      }
    }
  }
}
